# AEGIS environment configuration
# Copy to `.env` in the repo root. `.env` is gitignored - never commit real values.

# --- Database -------------------------------------------------------------
# SQLAlchemy URL. Defaults to a file in the repo root; no server to install.
DATABASE_URL=sqlite:///aegis.db

# --- watsonx.ai (OPTIONAL) ------------------------------------------------
# Omit all three to use the deterministic template BLUF generator. The system
# is fully demoable without them - the fallback is not a degraded mode, it is a
# supported path.
WATSONX_API_KEY=your-api-key-here
WATSONX_PROJECT_ID=your-project-id-here
WATSONX_URL=https://eu-gb.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# --- Enrichment -----------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Minimum cosine score before a technique mapping is retained.
ATTACK_MAPPING_FLOOR=0.25
# How many ranked technique candidates to keep per alert.
ATTACK_TOP_K=3

# --- Correlation ----------------------------------------------------------
# Edge weight cutoff. Raise toward 0.6 if incidents over-merge; lower toward
# 0.35 if every alert becomes its own incident.
CORRELATION_THRESHOLD=0.45
# Temporal decay half-life in seconds (Signal 2). 30min default.
TEMPORAL_HALFLIFE_SECONDS=1800
# Coarse pre-filter window, in hours, bounding pairwise comparison.
CORRELATION_WINDOW_HOURS=24
# Safety cap so one noisy indicator cannot merge the whole corpus.
MAX_INCIDENT_SIZE=40

# --- API ------------------------------------------------------------------
API_PORT=8000
API_HOST=127.0.0.1
