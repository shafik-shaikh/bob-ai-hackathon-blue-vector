# AEGIS environment configuration
# Copy to `.env` in the repo root. `.env` is gitignored - never commit real values.
# Every variable here is read in src/config.py and nowhere else.

# --- Database -------------------------------------------------------------
# SQLite file, relative to the repo root. No server to install.
DATABASE_URL=sqlite:///aegis.db

# --- watsonx.ai (OPTIONAL) ------------------------------------------------
# Leave the placeholders to use the deterministic template BLUF generator.
# The template is not a degraded mode: it is the path the demo runs on, and
# watsonx (Granite) only rewrites the narrative fields when it is reachable
# and its output validates. Requires `pip install ibm-watsonx-ai`.
WATSONX_API_KEY=your-api-key-here
WATSONX_PROJECT_ID=your-project-id-here
WATSONX_URL=https://eu-gb.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
# How many top-ranked incidents get a BLUF generated by the pipeline.
BLUF_TOP_N=10

# --- Enrichment -----------------------------------------------------------
# tfidf (default, numpy only) or sbert (requires sentence-transformers).
EMBEDDING_BACKEND=tfidf
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Minimum calibrated score before a technique mapping is retained.
ATTACK_MAPPING_FLOOR=0.35
# How many ranked technique candidates to keep per alert.
ATTACK_TOP_K=3

# --- Correlation ----------------------------------------------------------
# Edge weight cutoff. Tuned against the corpus ground truth (src/eval/results.json):
# 0.40 recovers one more geo track but pulls noise into two scenarios; 0.50
# fragments the phishing chain. Raise toward 0.55 if incidents over-merge.
CORRELATION_THRESHOLD=0.45
# Temporal decay half-life in seconds (Signal 2). 1 hour: hands-on-keyboard
# intrusions have gaps of 30-60 minutes between stages.
TEMPORAL_HALFLIFE_SECONDS=3600
# Coarse pre-filter window, in hours, bounding pairwise comparison. Pairs that
# share an indicator are always compared regardless of this window.
CORRELATION_WINDOW_HOURS=24
# Safety cap so one noisy indicator cannot merge the whole corpus.
MAX_INCIDENT_SIZE=40

# --- API ------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
